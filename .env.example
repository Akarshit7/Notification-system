# ---- Runtime ----
NODE_ENV=development
LOG_LEVEL=info

# ---- PostgreSQL (required) ----
DATABASE_URL=postgresql://notification:notification@localhost:5432/notification

# ---- Redis (required) ----
REDIS_URL=redis://localhost:6379

# ---- RabbitMQ (required) ----
RABBITMQ_URL=amqp://guest:guest@localhost:5672

# ---- AWS / LocalStack (required) ----
AWS_REGION=us-east-1
AWS_ACCESS_KEY=localstack
AWS_SECRET_KEY=localstack
# Optional: point SNS/SQS at LocalStack during local development
# SNS_ENDPOINT=http://localhost:4566
# SQS_ENDPOINT=http://localhost:4566

# ---- OpenTelemetry (optional) ----
OTEL_SERVICE_NAME=notification-platform
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# ---- Metrics (optional) ----
PROMETHEUS_METRICS_PATH=/metrics

# ---- HTTP port (optional, per-service default used when unset) ----
# PORT=3000
