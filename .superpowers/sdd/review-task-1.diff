+import { z } from 'zod';
+
+export const EnvironmentSchema = z.object({
+  NODE_ENV: z.enum(['development', 'staging', 'production']).default('development'),
+  PORT: z.coerce.number().positive().default(3000),
+  DATABASE_URL: z.string().url(),
+  REDIS_URL: z.string().url(),
+  RABBITMQ_URL: z.string().url(),
+  AWS_ACCESS_KEY: z.string().min(1),
+  AWS_SECRET_KEY: z.string().min(1),
+  AWS_REGION: z.string().default('us-east-1'),
+  SNS_ENDPOINT: z.string().url().optional(),
+  SQS_ENDPOINT: z.string().url().optional(),
+  LOG_LEVEL: z.enum(['trace', 'debug', 'info', 'warn', 'error', 'fatal']).default('info'),
+  OTEL_EXPORTER_OTLP_ENDPOINT: z.string().url().default('http://localhost:4318'),
+  OTEL_SERVICE_NAME: z.string().default('notification-platform'),
+  PROMETHEUS_METRICS_PATH: z.string().default('/metrics'),
+});
+
+export type Environment = z.infer<typeof EnvironmentSchema>;
+```
+
+- [ ] **Step 2: Create config service**
+
+Create `libs/config/src/config.service.ts`:
+```typescript
+import { Injectable } from '@nestjs/common';
+import { Environment, EnvironmentSchema } from './config.schema';
+
+@Injectable()
+export class ConfigService {
+  private readonly environment: Environment;
+
+  constructor() {
+    const result = EnvironmentSchema.safeParse(process.env);
+    if (!result.success) {
+      throw new Error(
+        `Environment validation failed: ${result.error.flatten().fieldErrors}\n` +
+        `Missing/invalid variables: ${JSON.stringify(result.error.flatten().fieldErrors, null, 2)}`,
+      );
+    }
+    this.environment = result.data;
+  }
+
+  get<T extends keyof Environment>(key: T): Environment[T] {
+    return this.environment[key];
+  }
+
+  getAll(): Environment {
+    return { ...this.environment };
+  }
+
+  get isDevelopment(): boolean {
+    return this.environment.NODE_ENV === 'development';
+  }
+
+  get isProduction(): boolean {
+    return this.environment.NODE_ENV === 'production';
+  }
+
+  get isStaging(): boolean {
+    return this.environment.NODE_ENV === 'staging';
+  }
+}
+```
